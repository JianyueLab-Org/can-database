---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RoutePlanner from "@/components/RoutePlanner.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportSummary } from "@/lib/canDb";

/**
 * 航路生成器。
 *
 * **规划在 can-db，不在这里。** 这一页只把机场清单交给岛屿（用来在提交前判断代号是否在
 * 库里），其余全部走 `/aip/route`。`?from=&to=&level=` 由岛屿自己读：带着链接进来就直
 * 接跑一次。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "route");
const messages = getMessages(locale, "route");

const result = await callDb<AirportSummary[]>(Astro, "/api/v1/aip/airports");
const airports = (result.ok ? (result.data ?? []) : []).map((a) => a.icao);

/**
 * 成员的 `aipAccess`，只为决定「未使用受限汇编」那个标签出不出。不是权限判断：开关是
 * 整个控制台的「隐藏 NAIP 数据」，见 `src/lib/hideNaip.ts`。
 */
const aipAccess = Astro.locals.user?.aipAccess ?? 0;
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-5xl">
    <PageHeader title={t("title")} description={t("description")} />

    <RoutePlanner
      messages={messages}
      airports={airports}
      aipAccess={aipAccess}
      client:only="vue"
    >
      {/* client:only 在水合前什么都不渲染 —— 先占住表单那一行的位置。 */}
      <div slot="fallback" class="skeleton h-[4.75rem] w-full rounded-card">
      </div>
    </RoutePlanner>
  </div>
</AppLayout>
