---
import AppLayout from "@/layouts/AppLayout.astro";
import RoutePlanner from "@/components/RoutePlanner.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportSummary } from "@/lib/canDb";

/**
 * 航路生成器。
 *
 * **规划在 can-db，不在这里。** 这一页只把机场清单交给岛屿（用来在提交前判断代号是否在
 * 库里），其余全部走 `/aip/route`。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "route");
const messages = getMessages(locale, "route");

const result = await callDb<AirportSummary[]>(Astro, "/api/v1/aip/airports");
const airports = (result.ok ? (result.data ?? []) : []).map((a) => a.icao);
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-6">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {t("title")}
      </h1>
      <p class="mt-2 max-w-2xl text-muted">{t("description")}</p>
    </header>

    <RoutePlanner messages={messages} airports={airports} client:only="vue" />
  </div>
</AppLayout>
