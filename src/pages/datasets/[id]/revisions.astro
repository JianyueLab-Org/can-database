---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import EmptyState from "@jianyuelab-org/can-ui/components/EmptyState.vue";
import AlertBox from "@jianyuelab-org/can-ui/components/AlertBox.vue";
import Icon from "@jianyuelab-org/can-ui/components/Icon.vue";
import { getLocale, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import { canManage } from "@/lib/config";
import type { Dataset, Revision, RevisionPage } from "@/lib/canDb";

/**
 * 一期数据的修订记录 —— 只给 5 级「管理/编辑」，别的级别拿到 404 页。
 *
 * 服务端渲染，按 can-db 给的 `next` 游标翻页（`?before=`）。改动按列列出：新增只有改后，
 * 删除只有改前，修改只列值变了的那几列。
 */
if (!canManage(Astro.locals.user?.aipAccess ?? 0)) {
  return Astro.rewrite("/404");
}

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.rewrite("/404");

const before = Number(Astro.url.searchParams.get("before"));
const cursor = Number.isInteger(before) && before > 0 ? before : 0;

const [datasets, result] = await Promise.all([
  callDb<Dataset[]>(Astro, "/api/v1/aip/datasets"),
  callDb<RevisionPage>(
    Astro,
    `/api/v1/aip/datasets/${id}/revisions?limit=50${cursor ? `&before=${cursor}` : ""}`,
  ),
]);
const dataset = (datasets.data ?? []).find((d) => d.id === id);
if (!dataset) return Astro.rewrite("/404");

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "revisions");

const revisions = result.data?.revisions ?? [];
const next = result.data?.next ?? null;

const OP_LABEL: Record<string, string> = {
  insert: "opInsert",
  update: "opUpdate",
  delete: "opDelete",
  clone: "opClone",
};
const OP_BADGE: Record<string, string> = {
  insert: "badge badge-success",
  update: "badge badge-info",
  delete: "badge badge-danger",
  clone: "badge badge-neutral",
};

const show = (value: unknown): string => {
  if (value === undefined) return "";
  if (value === null) return "null";
  return typeof value === "string" ? value : JSON.stringify(value);
};

const keyText = (r: Revision) =>
  r.key
    ? Object.entries(r.key)
        .map(([k, v]) => `${k}=${show(v)}`)
        .join(" ")
    : "";

/** 列级改动：两边都有的列只列值不同的；只有一边的整列列出。 */
function diff(r: Revision) {
  const b = r.before ?? {};
  const a = r.after ?? {};
  const names = [...new Set([...Object.keys(b), ...Object.keys(a)])];
  return names
    .filter(
      (n) =>
        !(n in b && n in a) || JSON.stringify(b[n]) !== JSON.stringify(a[n]),
    )
    .map((n) => ({
      name: n,
      hasBefore: n in b,
      hasAfter: n in a,
      before: n in b ? show(b[n]) : "",
      after: n in a ? show(a[n]) : "",
    }));
}

/** 列少的改动直接展开，一眼读完；多的收起，免得一页五十行被撑成几屏。 */
const OPEN_BELOW = 4;

const fmt = (iso: string) =>
  new Date(iso).toISOString().slice(0, 19).replace("T", " ");
---

<AppLayout title={t("title", { airac: dataset.airac })}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader
      title={t("title", { airac: dataset.airac })}
      description={t("description")}
      back={{ href: "/datasets", label: t("back") }}
    >
      <Fragment slot="actions">
        <a href={`/datasets/${id}/edit`} class="btn btn-secondary">
          <Icon name="pencilSquare" class="size-4" />
          {t("edit")}
        </a>
      </Fragment>
    </PageHeader>

    {
      !result.ok ? (
        <AlertBox variant="danger" title={t("errorTitle")}>
          {t("error", { message: result.message ?? result.error ?? "" })}
        </AlertBox>
      ) : revisions.length === 0 ? (
        <div class="card">
          <EmptyState
            title={cursor > 0 ? t("emptyPage") : t("empty")}
            icon="clock"
          >
            {cursor > 0 && (
              <a
                slot="action"
                href={`/datasets/${id}/revisions`}
                class="btn btn-secondary"
              >
                {t("newest")}
              </a>
            )}
          </EmptyState>
        </div>
      ) : (
        <>
          <p class="mb-3 text-sm text-muted">
            {cursor > 0
              ? t("pageOlder", { n: revisions.length })
              : t("pageNewest", { n: revisions.length })}
          </p>
          <div
            class="scroll-shadow-x overflow-x-auto"
            style="--scroll-shadow-bg: var(--surface)"
          >
            <table class="data-table w-full text-sm">
              <thead>
                <tr>
                  <th>{t("at")}</th>
                  <th>{t("op")}</th>
                  <th>{t("table")}</th>
                  <th>{t("key")}</th>
                  <th>{t("actor")}</th>
                  <th>{t("diff")}</th>
                </tr>
              </thead>
              <tbody>
                {revisions.map((r) => {
                  const changes = diff(r);
                  return (
                    <tr class="align-top">
                      <td
                        data-label={t("at")}
                        class="tnum whitespace-nowrap text-muted"
                      >
                        {fmt(r.at)}
                      </td>
                      <td data-label={t("op")}>
                        <span class={OP_BADGE[r.op] ?? "badge badge-neutral"}>
                          {OP_LABEL[r.op] ? t(OP_LABEL[r.op]) : r.op}
                        </span>
                      </td>
                      <td data-label={t("table")} class="font-mono">
                        {r.table}
                      </td>
                      <td
                        data-label={t("key")}
                        class="break-all font-mono text-ink"
                      >
                        {keyText(r)}
                      </td>
                      <td data-label={t("actor")}>{r.actor}</td>
                      <td data-label={t("diff")} class="min-w-64">
                        {changes.length === 0 ? (
                          <span class="text-faint">{t("noDiff")}</span>
                        ) : (
                          <details open={changes.length < OPEN_BELOW}>
                            <summary class="link cursor-pointer">
                              {t("showDiff", { n: changes.length })}
                            </summary>
                            {/* 一列一行：列名，然后「改前 → 改后」。新增只有改后，删除
                                只有改前 —— 缺的那一边不画，而不是画一个空框。 */}
                            <dl class="mt-2 space-y-1.5 text-left text-xs">
                              {changes.map((c) => (
                                <div class="rounded-control bg-surface-sunken px-2 py-1.5">
                                  <dt class="font-mono text-muted">{c.name}</dt>
                                  <dd class="mt-0.5 flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 font-mono">
                                    {c.hasBefore && (
                                      <span
                                        class="break-all text-danger line-through decoration-1"
                                        title={t("before")}
                                      >
                                        <span class="sr-only">
                                          {t("before")}:{" "}
                                        </span>
                                        {c.before}
                                      </span>
                                    )}
                                    {c.hasBefore && c.hasAfter && (
                                      <span
                                        class="text-faint"
                                        aria-hidden="true"
                                      >
                                        →
                                      </span>
                                    )}
                                    {c.hasAfter && (
                                      <span
                                        class="break-all text-success"
                                        title={t("after")}
                                      >
                                        <span class="sr-only">
                                          {t("after")}:{" "}
                                        </span>
                                        {c.after}
                                      </span>
                                    )}
                                  </dd>
                                </div>
                              ))}
                            </dl>
                          </details>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      /* 游标翻页只能往更早走一步、或者回到最新 —— can-db 只给 `next`，没有「上一
        页」的游标，也不给总数，所以这里不画页码。 */
    }
    {
      result.ok && (cursor > 0 || next) && (
        <nav
          class="mt-4 flex items-center justify-between gap-3"
          aria-label={t("pagination")}
        >
          {cursor > 0 ? (
            <a href={`/datasets/${id}/revisions`} class="btn btn-secondary">
              <Icon name="chevronDoubleLeft" class="size-4" />
              {t("newest")}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/datasets/${id}/revisions?before=${next}`}
              class="btn btn-secondary"
            >
              {t("older")}
              <Icon name="chevronRight" class="size-4" />
            </a>
          ) : (
            <span class="text-sm text-faint">{t("end")}</span>
          )}
        </nav>
      )
    }
  </div>
</AppLayout>
