---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import DataEditor from "@/components/DataEditor.vue";
import AlertBox from "@jianyuelab-org/can-ui/components/AlertBox.vue";
import Icon from "@jianyuelab-org/can-ui/components/Icon.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import { canManage } from "@/lib/config";
import type { Dataset, TableSpec } from "@/lib/canDb";

/**
 * 一期数据的逐行编辑器 —— 只给 5 级「管理/编辑」。
 *
 * 别的级别拿到的是 404 页，和一个不存在的数据集一样：这一页的存在本身不对他们说。
 * 真正的写门槛在 can-db 的 `withWrite`，这里只决定渲不渲染。
 */
if (!canManage(Astro.locals.user?.aipAccess ?? 0)) {
  return Astro.rewrite("/404");
}

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.rewrite("/404");

const [datasets, tables] = await Promise.all([
  callDb<Dataset[]>(Astro, "/api/v1/aip/datasets"),
  callDb<TableSpec[]>(Astro, "/api/v1/aip/tables"),
]);
const dataset = (datasets.data ?? []).find((d) => d.id === id);
if (!dataset) return Astro.rewrite("/404");

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "editor");
const messages = getMessages(locale, "editor");

const params = Astro.url.searchParams;
const filter: Record<string, string> = {};
for (const [k, v] of params) if (k !== "table" && k !== "offset") filter[k] = v;
const initial = {
  table: params.get("table") ?? "",
  filter,
  offset: Math.max(0, Number(params.get("offset")) || 0),
};
---

<AppLayout title={t("title", { airac: dataset.airac })}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader
      title={t("title", { airac: dataset.airac })}
      description={t("description")}
      eyebrow={t("eyebrow")}
      back={{ href: "/datasets", label: t("back") }}
    >
      <Fragment slot="actions">
        <a href={`/datasets/${id}/revisions`} class="btn btn-secondary">
          <Icon name="clock" class="size-4" />
          {t("revisions")}
        </a>
      </Fragment>
    </PageHeader>

    {
      tables.ok ? (
        <DataEditor
          client:load
          datasetId={id}
          tables={tables.data ?? []}
          initial={initial}
          messages={messages}
        />
      ) : (
        <AlertBox variant="danger" title={t("tablesError")}>
          {tables.message ?? tables.error}
        </AlertBox>
      )
    }
  </div>
</AppLayout>
