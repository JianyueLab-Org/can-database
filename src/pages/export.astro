---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import DatasetExport from "@/components/DatasetExport.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportSummary } from "@/lib/canDb";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "exportPage");
const messages = getMessages(locale, "exportPage");
const airportResult = await callDb<AirportSummary[]>(
  Astro,
  "/api/v1/aip/airports",
);
const airports = airportResult.ok ? (airportResult.data ?? []) : [];
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader title={t("title")} description={t("description")} />
    <DatasetExport
      messages={messages}
      locale={locale}
      airports={airports}
      airportListFailed={!airportResult.ok}
      client:load
    />
  </div>
</AppLayout>
