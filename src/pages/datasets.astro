---
import AppLayout from "@/layouts/AppLayout.astro";
import { getLocale, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import { isRestricted, type Dataset } from "@/lib/canDb";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "datasets");

const result = await callDb<Dataset[]>(Astro, "/api/v1/aip/datasets");
const datasets = result.ok ? (result.data ?? []) : [];

const stateBadge: Record<string, string> = {
  active: "badge badge-success",
  loading: "badge badge-warning",
  superseded: "badge badge-neutral",
};
const fmt = (iso: string | null) =>
  iso ? new Date(iso).toISOString().slice(0, 16).replace("T", " ") : t("never");
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-6">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {t("title")}
      </h1>
      <p class="mt-2 max-w-2xl text-muted">{t("description")}</p>
    </header>

    {
      datasets.length === 0 ? (
        <div class="card p-10 text-center">
          <p class="text-muted">{t("empty")}</p>
        </div>
      ) : (
        <div class="scroll-edge-y overflow-x-auto">
          <table class="data-table w-full text-sm">
            <thead>
              <tr>
                <th>{t("airac")}</th>
                <th>{t("access")}</th>
                <th>{t("state")}</th>
                <th>{t("redistributable")}</th>
                <th>{t("airports")}</th>
                <th>{t("activated")}</th>
              </tr>
            </thead>
            <tbody>
              {datasets.map((d) => (
                <tr>
                  <td data-label={t("airac")} class="tnum font-mono">
                    {d.airac}
                  </td>
                  {/* 受限的那几批要一眼看得出来 —— 一个校对数据的人应该分得清手上
                      这条是官方汇编还是面向模拟的派生物。 */}
                  <td data-label={t("access")}>
                    {isRestricted(d.minAccess) ? (
                      <span class="badge badge-danger">{t("restricted")}</span>
                    ) : (
                      <span class="text-faint">{t("open")}</span>
                    )}
                  </td>
                  <td data-label={t("state")}>
                    <span class={stateBadge[d.state] ?? "badge badge-neutral"}>
                      {d.state}
                    </span>
                  </td>
                  <td data-label={t("redistributable")}>
                    {d.redistributable ? t("yes") : t("no")}
                  </td>
                  <td data-label={t("airports")} class="tnum">
                    {d.airports}
                  </td>
                  <td data-label={t("activated")} class="tnum">
                    {fmt(d.activatedAt)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AppLayout>
