---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import NetworkMap from "@/components/NetworkMap.vue";
import EmptyState from "@jianyuelab-org/can-ui/components/EmptyState.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { Overview } from "@/lib/canDb";

/**
 * 全网图。
 *
 * 机场、航路网都由岛屿按视野（或按 FIR）取，见 `NetworkMap.vue` 抬头。这里只取 FIR
 * 清单和全库机场数（`/aip/overview`，「全部」那一格的数和空库判断）。
 *
 * FIR 清单是 can-db 给的（`/aip/firs`），不是从机场里推的 —— 和 /fixes 一致。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "map");
const messages = {
  ...getMessages(locale, "map"),
  basemap: getMessages(locale, "basemap"),
};

const [overviewResult, firsResult] = await Promise.all([
  callDb<Overview>(Astro, "/api/v1/aip/overview"),
  callDb<string[]>(Astro, "/api/v1/aip/firs"),
]);
const total = overviewResult.ok
  ? (overviewResult.data?.airports ?? null)
  : null;
const firs = firsResult.ok ? (firsResult.data ?? []) : [];

// `/map?fir=ZGZU` 是从航路点页链过来的。**在服务端就对着已知 FIR 列表校验**，而不是
// 原样交给岛屿：一个乱填的值会筛出一张空图，看起来像数据没了。不认识就当没传。
const requestedFir = Astro.url.searchParams.get("fir");
const initialFir =
  requestedFir && firs.includes(requestedFir) ? requestedFir : null;
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader title={t("title")} description={t("description")} />

    {
      total === 0 ? (
        <div class="card">
          <EmptyState icon="map" title={t("empty")} />
        </div>
      ) : (
        <NetworkMap
          messages={messages}
          total={total}
          firs={firs}
          initialFir={initialFir}
          client:only="vue"
        >
          {/* client:only 在水合前什么都不渲染 —— 先占住地图的位置和高度，免得图出来时整
              页往下一跳。高度和岛屿里那个容器是同一个表达式。 */}
          <div
            slot="fallback"
            class="skeleton h-[max(26rem,calc(100dvh-16rem))] w-full rounded-xl"
          />
        </NetworkMap>
      )
    }
  </div>
</AppLayout>
