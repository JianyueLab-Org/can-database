---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import StatCard from "@jianyuelab-org/can-ui/components/StatCard.vue";
import { getLocale, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { Overview } from "@/lib/canDb";

/**
 * 总览：现在生效的是哪一期、哪一个来源。
 *
 * 服务端渲染而不是岛屿 —— 这一页没有任何交互，而一个先画骨架再自己去取的岛屿只是
 * 多一个往返。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "overview");

// 一条路由把这一页要的全部答出来。**这里不再推导任何东西** —— 「哪一期是活的」
// 是一条关于这批数据的规则，归 can-db（见 internal/aip 的 Overview）。
const result = await callDb<Overview>(Astro, "/api/v1/aip/overview");
const overview = result.ok ? result.data : null;
const datasets = overview?.datasets ?? 0;
const active = overview?.active ?? [];
const liveAirac = overview?.liveAirac ?? null;
const totalAirports = overview?.airports ?? 0;
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-5xl">
    <PageHeader title={t("title")} description={t("description")} />

    {
      datasets === 0 ? (
        <div class="card p-10 text-center">
          <p class="text-muted">{t("noData")}</p>
        </div>
      ) : (
        <>
          {/* can-ui 的 `StatCard`，不再手抄一份。原来那两块是「小号全大写标签 +
              大号 tnum 数字」，也就是 StatCard 的版式照着写了一遍 —— 而设计系统那
              一份还带图标槽、hover 抬升和 `truncate`（手机上两块并排时长标签不会
              截成空的）。

              **第三块是补上的，不是新加的需求。** 网格本来就写着
              `sm:grid-cols-3` 却只放了两块，`sm` 以上右边空着一格；`overview.datasets`
              这个数这一页早就取回来了（下面 `datasets === 0` 那个判断用的就是
              它），只是没显示。它挂 `href` 指向 `/datasets` —— 一个总览页上的数
              字，人看见了下一步就是想看清单。 */}
          <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
            <StatCard
              label={t("airacLive")}
              value={liveAirac ?? "—"}
              icon="calendarDays"
            />
            <StatCard
              label={t("airports")}
              value={totalAirports}
              icon="mapPin"
            />
            <StatCard
              label={t("datasets")}
              value={datasets}
              icon="squares2x2"
              accent="neutral"
              href="/datasets"
            />
          </div>

          <ul class="space-y-3">
            {active.map((d) => (
              <li class="card flex flex-wrap items-center gap-x-6 gap-y-2 p-4">
                <span class="tnum font-mono text-sm font-semibold text-can">
                  {d.airac}
                </span>
                <span class="badge badge-success">{t("live")}</span>
                <span
                  class={
                    d.redistributable
                      ? "badge badge-info"
                      : "badge badge-warning"
                  }
                >
                  {d.redistributable ? t("open") : t("licensed")}
                </span>
                <span class="tnum ml-auto text-sm text-muted">
                  {d.airports} {t("airports")}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</AppLayout>
