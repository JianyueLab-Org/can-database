---
import { NotFound } from "@jianyuelab-org/can-ui";
import AppLayout from "@/layouts/AppLayout.astro";
import { getLocale, useTranslations } from "@/lib/i18n";
import { SITE_ORIGINS } from "@/lib/nav";

/**
 * 找不到的页面 —— 也是 5 级以外的人打开编辑页、修订记录时看到的那一页（那两页在
 * frontmatter 里 `rewrite("/404")`），所以这里不说「你没有权限」，只说页面不在。
 *
 * 在共享链接之后多给一个：机场清单 —— 走到这里的人多半是拼错了一个机场的地址。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "notFound");
Astro.response.status = 404;
---

<AppLayout title="404">
  <NotFound current="database" locale={locale} origins={SITE_ORIGINS}>
    <a slot="actions" href="/airports" class="btn btn-secondary px-5 py-2.5">
      {t("airports")}
    </a>
  </NotFound>
</AppLayout>
