---
import AppLayout from "@/layouts/AppLayout.astro";
import { getLocale, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "notFound");
---

<AppLayout title={t("code")}>
  <div class="flex min-h-[60vh] items-center justify-center px-4 py-16">
    <div class="mx-auto max-w-md text-center">
      <p
        class="text-[6rem] font-bold leading-none tracking-tighter text-can/20"
      >
        {t("code")}
      </p>
      <h1 class="-mt-4 text-2xl font-bold tracking-tight text-ink">
        {t("title")}
      </h1>
      <p class="mx-auto mt-4 text-muted">{t("description")}</p>
      <div class="mt-8">
        <a href="/" class="btn btn-primary px-5 py-2.5">{t("home")}</a>
      </div>
    </div>
  </div>
</AppLayout>
