---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Airports from "@/components/Airports.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportSummary, Overview } from "@/lib/canDb";
import { AIRPORT_PAGE, REGION_PATTERN, airportsQuery } from "@/lib/viewport";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "airports");
const messages = getMessages(locale, "airports");

/**
 * 导出用的字典，只带 `airports` 列真正用到的命名空间：机场清单那几列大多在
 * `airports` 里，`datasets.airac` 是例外——按命名空间嵌套，不往顶层 spread。
 */
const exportDict = {
  airports: messages,
  datasets: getMessages(locale, "datasets"),
  export: getMessages(locale, "export"),
};

/**
 * 第一页在这里取，用地址栏上的同一组筛选（岛屿挂载后读到的也是这一组，不会再取一次）。
 * 不认识的 FIR 和格式不对的区域码当没传。
 */
const [firsResult, overviewResult] = await Promise.all([
  callDb<string[]>(Astro, "/api/v1/aip/firs"),
  callDb<Overview>(Astro, "/api/v1/aip/overview"),
]);
const firs = firsResult.ok ? (firsResult.data ?? []) : [];
const params = Astro.url.searchParams;
const requestedFir = params.get("fir") ?? "";
const requestedRegion = (params.get("region") ?? "").trim().toUpperCase();
const initialFilters = {
  q: (params.get("q") ?? "").trim(),
  fir: firs.includes(requestedFir) ? requestedFir : "",
  region: REGION_PATTERN.test(requestedRegion) ? requestedRegion : "",
};

const result = await callDb<AirportSummary[]>(
  Astro,
  `/api/v1/aip/airports?${airportsQuery({ ...initialFilters, limit: AIRPORT_PAGE })}`,
);
const airports = result.ok ? (result.data ?? []) : [];
const total = overviewResult.ok
  ? (overviewResult.data?.airports ?? null)
  : null;
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader
      title={t("title")}
      description={t("description", { count: total ?? airports.length })}
    />

    <Airports
      messages={messages}
      airports={airports}
      nextCursor={result.nextCursor ?? null}
      total={total}
      firs={firs}
      initialFilters={initialFilters}
      licence={result.licence}
      exportMessages={exportDict}
      client:load
    />
  </div>
</AppLayout>
