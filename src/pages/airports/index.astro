---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Airports from "@/components/Airports.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportSummary } from "@/lib/canDb";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "airports");
const messages = getMessages(locale, "airports");

const result = await callDb<AirportSummary[]>(Astro, "/api/v1/aip/airports");
const airports = result.ok ? (result.data ?? []) : [];
---

<AppLayout title={t("title")}>
  <div class="mx-auto w-full max-w-6xl">
    <PageHeader
      title={t("title")}
      description={t("description", { count: airports.length })}
    />

    <Airports messages={messages} airports={airports} client:load />
  </div>
</AppLayout>
