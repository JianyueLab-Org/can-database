---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import RichText from "@/components/RichText.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import AirportMap from "@/components/AirportMap.vue";
import Procedures from "@/components/Procedures.vue";
import StandsTable from "@/components/airport/StandsTable.vue";
import EmptyState from "@jianyuelab-org/can-ui/components/EmptyState.vue";
import Icon from "@jianyuelab-org/can-ui/components/Icon.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportDetail } from "@/lib/canDb";
import { airportExportHref } from "@/lib/export/airportLink";
import { canManage } from "@/lib/config";

/**
 * 一个机场的全部：跑道、机位、进离场程序。
 *
 * 服务端渲染。ZGGG 是这里最大的一份 —— 10 条跑道、520 个机位、168 个程序 —— 而它
 * 仍然是一次查询：can-db 的 `procedures()` 用一个 lateral aggregate 把程序点一次
 * 取回，而不是每个程序一次往返。
 */
const icao = (Astro.params.icao ?? "").toUpperCase();
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "airports");
const mapMessages = {
  ...getMessages(locale, "airportMap"),
  basemap: getMessages(locale, "basemap"),
};
const procMessages = getMessages(locale, "procedures");
const standMessages = getMessages(locale, "airportStands");

const result = await callDb<AirportDetail>(
  Astro,
  `/api/v1/aip/airports/${encodeURIComponent(icao)}`,
);
const airport = result.ok ? result.data : null;

/** 地面要素编辑器的入口只给 5 级；编辑页自己也按同一条判。 */
const canEditGround = canManage(Astro.locals.user?.aipAccess ?? 0);

/**
 * 跑道的两半拼成一行。
 *
 * 几何（入口和终点坐标、磁航向）和物理（长宽、道面、强度、入口标高）来自**两份不同的数
 * 据**，各自按 (机场, 代号) 解析 —— 一条跑道可能只有其中一半。拼在这里而不是并排两张
 * 表：读的人问的是「这条跑道是什么样」，不该由他自己对代号。
 */
const geom = new Map((airport?.runways ?? []).map((r) => [r.id, r]));
const phys = new Map((airport?.runwayDetails ?? []).map((r) => [r.ident, r]));
const runwayIdents = [...new Set([...geom.keys(), ...phys.keys()])].sort();
const runwayRows = runwayIdents.map((ident) => {
  const g = geom.get(ident);
  const p = phys.get(ident);
  return {
    ident,
    opposite: g?.opposite ?? p?.pair ?? null,
    hdg: g?.hdg ?? null,
    lat: g?.lat ?? null,
    lon: g?.lon ?? null,
    endLat: g?.endLat ?? null,
    endLon: g?.endLon ?? null,
    lengthM: p?.lengthM ?? null,
    widthM: p?.widthM ?? null,
    surface: p?.surface ?? null,
    strength: p?.strength ?? null,
    strengthDesc: p?.strengthDesc ?? null,
    trueBrg: p?.trueBrg ?? null,
    thrElevM: p?.thrElevM ?? null,
  };
});

/**
 * 机场的事实做成「标签 / 值」两行一组，而不是一串 `FIR: ZGZU`。
 *
 * 原来这里是两段 `text-sm text-muted` 的 `<span>`，最多十二项挤在两行里 —— 标签和
 * 值同号同色、只靠一个冒号分开，于是这一堆字**没有任何一处可以让眼睛落下来**。要在
 * 里面找磁差，只能从头读。分成两级（标签 `.text-eyebrow` 退到 `text-faint`，值升到
 * `text-ink`）之后它是一张可以扫的表，而这一页的用途正是核对某一个数。
 *
 * **两类项目的缺失处理不一样，这是原来就有的规矩，保留：** 前五项任何来源都该给得
 * 出，缺了要显示成「—」（一个空着的格子和一个没渲染出来的格子分不清）；后面几项只
 * 有官方汇编有，给不了就**整项不出现** —— 一排「—」比没有更占地方。
 */
interface Fact {
  label: string;
  value: string;
  /** 数字要等宽，否则同一列里 `1` 和 `7` 的宽度不同，值对不齐。 */
  tnum?: boolean;
  mono?: boolean;
}

const facts: Fact[] = !airport
  ? []
  : [
      { label: t("fir"), value: airport.fir ?? "—" },
      {
        label: t("coords"),
        value: `${airport.lat.toFixed(5)}, ${airport.lon.toFixed(5)}`,
        tnum: true,
      },
      {
        label: t("elev"),
        value: airport.elev === null ? t("noElev") : `${airport.elev} ft`,
        tnum: true,
      },
      {
        label: t("variation"),
        value: airport.variation === null ? "—" : String(airport.variation),
        tnum: true,
      },
      { label: t("airac"), value: airport.airac, tnum: true },
      ...(airport.iata
        ? [{ label: "IATA", value: airport.iata, mono: true }]
        : []),
      ...(airport.transitionAltM
        ? [
            {
              label: t("transAlt"),
              value: `${airport.transitionAltM} m`,
              tnum: true,
            },
          ]
        : []),
      ...(airport.transitionLevelM
        ? [
            {
              label: t("transLevel"),
              value: `${airport.transitionLevelM} m`,
              tnum: true,
            },
          ]
        : []),
      ...(airport.speedLimitKt
        ? [
            {
              label: t("speedLimit"),
              value:
                `${airport.speedLimitKt} kt` +
                (airport.speedLimitBelowFt
                  ? ` <${airport.speedLimitBelowFt} ft`
                  : ""),
              tnum: true,
            },
          ]
        : []),
    ];

/**
 * 页内导航：图、跑道、机位、程序四节，各带条数。
 *
 * ZGGG 这一页从上到下是一张图、十行跑道、五百多个机位、一百六十多条程序 —— 要看程序得
 * 先滚过前面三节。这一排锚点让人直接跳过去，条数顺便回答「这一节有没有东西」。
 *
 * 桌面上吸顶，贴在 AppShell 那条 4rem 的顶栏下面（`lg:top-16`）；手机上不吸，那里一屏本
 * 来就窄，再压一条会把地图挤没。
 */
const sections = !airport
  ? []
  : [
      { id: "map", label: t("sectionMap"), count: undefined },
      { id: "runways", label: t("runways"), count: runwayRows.length },
      { id: "stands", label: t("standsTitle"), count: airport.stands.length },
      {
        id: "procedures",
        label: t("procedures"),
        count: airport.procedures.length,
      },
    ];
---

<AppLayout title={icao}>
  <div class="mx-auto w-full max-w-5xl">
    {
      !airport ? (
        <>
          <PageHeader
            title={icao}
            back={{ href: "/airports", label: t("back") }}
          >
            <span slot="title" class="font-mono">
              {icao}
            </span>
          </PageHeader>
          <div class="card">
            <EmptyState title={t("notFound")} icon="mapPin" compact />
          </div>
        </>
      ) : (
        <>
          <PageHeader
            title={airport.icao}
            description={airport.name ?? undefined}
            back={{ href: "/airports", label: t("back") }}
          >
            <span slot="title" class="font-mono">
              {airport.icao}
            </span>
            {/* 分类属性排在右边当标签 —— 它们没有「值」，和下面那张有单位有数字的
                事实表不是一类东西。导出按钮排在最后，是这一行里唯一能点的。 */}
            <Fragment slot="actions">
              {airport.isInternational && (
                <span class="badge badge-info">{t("international")}</span>
              )}
              {airport.bureau && (
                <span class="badge badge-neutral">{airport.bureau}</span>
              )}
              {airport.milOps && (
                <span class="badge badge-neutral">{airport.milOps}</span>
              )}
              <a
                href={airportExportHref(airport.icao)}
                class="btn btn-secondary"
              >
                <Icon name="arrowDownTray" class="size-4" />
                {t("exportAirport")}
              </a>
            </Fragment>
          </PageHeader>

          {/* 值**不截断**。一个被省略号切掉一半的坐标在这一页上比换行难看得多 ——
              这是拿来核对数字的地方，宁可让「23.39250, 113.29889」在手机上折成两
              行（逗号后面是它唯一的断点），也不能让人读到一个不完整的数。 */}
          <div class="card mb-4 p-4">
            <dl class="grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-3 lg:grid-cols-5">
              {facts.map((f) => (
                <div class="min-w-0">
                  <dt class="text-eyebrow text-faint">{f.label}</dt>
                  <dd
                    class:list={[
                      "mt-0.5 text-sm text-ink",
                      f.tnum && "tnum",
                      f.mono && "font-mono",
                    ]}
                  >
                    {f.value}
                  </dd>
                </div>
              ))}
            </dl>
            {/* The magnetic/true distinction is the single most expensive thing
                to get wrong downstream — it puts a parked aircraft skew to its
                own stand box — so the page says it rather than assuming the
                reader knows which one these columns are. */}
            <p class="mt-3 border-t border-subtle pt-3 text-xs text-faint">
              <RichText text={t("magneticNote")} />
            </p>
          </div>

          <nav
            aria-label={t("sectionNav")}
            class="material-thin z-30 -mx-1 mb-6 rounded-control px-1 py-2 lg:sticky lg:top-16"
          >
            <ul class="flex flex-wrap gap-1.5">
              {sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} class="chip">
                    {s.label}
                    {s.count !== undefined && (
                      <span class="chip__count">{s.count}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          {/* 图排在表格前面：这一页的读者多半是在核对「这个机位是不是在它该在的
              地方」，而那件事看图一眼就知道，看一张 520 行的坐标表要一行行读。 */}
          <section id="map" class="mb-10 scroll-mt-6 lg:scroll-mt-32">
            <SectionTitle title={t("sectionMap")}>
              {canEditGround && (
                <a
                  slot="actions"
                  href={`/airports/${encodeURIComponent(airport.icao)}/ground`}
                  class="btn btn-secondary h-8 px-2.5 text-xs"
                >
                  <Icon name="pencilSquare" class="size-3.5" />
                  {t("editGround")}
                </a>
              )}
            </SectionTitle>
            <AirportMap
              messages={mapMessages}
              airport={airport}
              client:only="vue"
            />
          </section>

          {/* **一张表，不是两张。** 几何（入口/终点坐标、航向）来自一份数据，物理
              （长宽道面强度）来自另一份，但读的人问的是同一件事：这条跑道是什么样。
              按代号拼在一起，缺哪一半就是破折号 —— 两张并排的表要读的人自己对代号。
              单位写在表头（手机上跟着 data-label 走），格子里只留数。 */}
          <section id="runways" class="mb-10 scroll-mt-6 lg:scroll-mt-32">
            <SectionTitle
              title={t("runways")}
              count={runwayRows.length}
              note={t("runwayNote")}
            />
            {runwayRows.length === 0 ? (
              <div class="card">
                <EmptyState title={t("noRunways")} compact />
              </div>
            ) : (
              <div
                class="scroll-shadow-x overflow-x-auto"
                style="--scroll-shadow-bg: var(--surface)"
              >
                <table class="data-table w-full text-sm">
                  <thead>
                    <tr>
                      <th>{t("rwy")}</th>
                      <th class="text-right">{t("rwyLengthM")}</th>
                      <th class="text-right">{t("rwyWidthM")}</th>
                      <th>{t("rwySurface")}</th>
                      <th>{t("rwyStrength")}</th>
                      <th class="text-right">{t("rwyHdg")}</th>
                      <th class="text-right">{t("rwyThrElevM")}</th>
                      <th class="text-right">{t("rwyThreshold")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {runwayRows.map((r) => (
                      <tr>
                        <td
                          data-label={t("rwy")}
                          class="font-mono font-medium text-ink"
                        >
                          {r.ident}
                          {r.opposite ? (
                            <span class="font-normal text-faint">
                              {" "}
                              / {r.opposite}
                            </span>
                          ) : null}
                        </td>
                        <td
                          data-label={t("rwyLengthM")}
                          class="tnum text-right"
                        >
                          {r.lengthM ? r.lengthM : "—"}
                        </td>
                        <td data-label={t("rwyWidthM")} class="tnum text-right">
                          {r.widthM ? r.widthM : "—"}
                        </td>
                        <td data-label={t("rwySurface")}>{r.surface ?? "—"}</td>
                        <td
                          data-label={t("rwyStrength")}
                          class="font-mono text-xs"
                        >
                          {r.strengthDesc ?? r.strength ?? "—"}
                        </td>
                        {/* 导航数据的磁航向优先；只有汇编那一半时退到真方位，带 T 标出
                            来 —— 两者差一个磁差，混在一列里不标就是错的数。 */}
                        <td data-label={t("rwyHdg")} class="tnum text-right">
                          {r.hdg ?? (r.trueBrg != null ? `${r.trueBrg}T` : "—")}
                        </td>
                        <td
                          data-label={t("rwyThrElevM")}
                          class="tnum text-right"
                        >
                          {r.thrElevM ? r.thrElevM : "—"}
                        </td>
                        <td
                          data-label={t("rwyThreshold")}
                          class="tnum text-right text-xs text-muted"
                        >
                          {r.lat != null
                            ? `${r.lat.toFixed(5)}, ${r.lon!.toFixed(5)}`
                            : "—"}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          <section id="stands" class="mb-10 scroll-mt-6 lg:scroll-mt-32">
            <SectionTitle
              title={t("standsTitle")}
              count={airport.stands.length}
            />
            <StandsTable
              messages={standMessages}
              stands={airport.stands}
              client:load
            />
          </section>

          <section id="procedures" class="mb-10 scroll-mt-6 lg:scroll-mt-32">
            <SectionTitle
              title={t("procedures")}
              count={airport.procedures.length}
            />
            <Procedures
              messages={procMessages}
              procedures={airport.procedures}
              runways={runwayIdents}
              client:load
            />
          </section>
        </>
      )
    }
  </div>
</AppLayout>
