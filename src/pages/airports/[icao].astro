---
import AppLayout from "@/layouts/AppLayout.astro";
import AirportMap from "@/components/AirportMap.vue";
import Procedures from "@/components/Procedures.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { callDb } from "@/server/canDb";
import type { AirportDetail } from "@/lib/canDb";

/**
 * 一个机场的全部：跑道、机位、进离场程序。
 *
 * 服务端渲染。ZGGG 是这里最大的一份 —— 10 条跑道、520 个机位、168 个程序 —— 而它
 * 仍然是一次查询：can-db 的 `procedures()` 用一个 lateral aggregate 把程序点一次
 * 取回，而不是每个程序一次往返。
 */
const icao = (Astro.params.icao ?? "").toUpperCase();
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "airports");
const mapMessages = getMessages(locale, "airportMap");
const procMessages = getMessages(locale, "procedures");

const result = await callDb<AirportDetail>(
  Astro,
  `/api/v1/aip/airports/${encodeURIComponent(icao)}`,
);
const airport = result.ok ? result.data : null;

/**
 * 跑道的两半拼成一行。
 *
 * 几何（入口和终点坐标、磁航向）和物理（长宽、道面、强度、入口标高）来自**两份不同的数
 * 据**，各自按 (机场, 代号) 解析 —— 一条跑道可能只有其中一半。拼在这里而不是并排两张
 * 表：读的人问的是「这条跑道是什么样」，不该由他自己对代号。
 */
const geom = new Map((airport?.runways ?? []).map((r) => [r.id, r]));
const phys = new Map((airport?.runwayDetails ?? []).map((r) => [r.ident, r]));
const runwayIdents = [...new Set([...geom.keys(), ...phys.keys()])].sort();
const runwayRows = runwayIdents.map((ident) => {
  const g = geom.get(ident);
  const p = phys.get(ident);
  return {
    ident,
    opposite: g?.opposite ?? p?.pair ?? null,
    hdg: g?.hdg ?? null,
    lat: g?.lat ?? null,
    lon: g?.lon ?? null,
    lengthM: p?.lengthM ?? null,
    widthM: p?.widthM ?? null,
    surface: p?.surface ?? null,
    strength: p?.strength ?? null,
    strengthDesc: p?.strengthDesc ?? null,
    trueBrg: p?.trueBrg ?? null,
    thrElevM: p?.thrElevM ?? null,
  };
});
---

<AppLayout title={icao}>
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <a href="/airports" class="link text-sm">← {t("back")}</a>

    {
      !airport ? (
        <div class="card mt-6 p-10 text-center">
          <p class="text-muted">{t("notFound")}</p>
        </div>
      ) : (
        <>
          <header class="mb-6 mt-4">
            <h1 class="font-mono text-3xl font-bold tracking-tight text-ink">
              {airport.icao}
            </h1>
            <p class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
              <span>
                {t("fir")}: {airport.fir ?? "—"}
              </span>
              <span class="tnum">
                {t("coords")}: {airport.lat.toFixed(5)},{" "}
                {airport.lon.toFixed(5)}
              </span>
              <span class="tnum">
                {t("elev")}:{" "}
                {airport.elev === null ? t("noElev") : `${airport.elev} ft`}
              </span>
              <span class="tnum">
                {t("variation")}: {airport.variation ?? "—"}
              </span>
              <span class="tnum">
                {t("airac")}: {airport.airac}
              </span>
            </p>
            {/* 汇编才有的那几项。别的来源给不了就整项不出现 —— 一排「—」比没有更占地方。 */}
            <p class="mt-1 flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
              {airport.name && <span>{airport.name}</span>}
              {airport.iata && <span class="font-mono">{airport.iata}</span>}
              {airport.transitionAltM && (
                <span class="tnum">
                  {t("transAlt")}: {airport.transitionAltM} m
                </span>
              )}
              {airport.transitionLevelM && (
                <span class="tnum">
                  {t("transLevel")}: {airport.transitionLevelM} m
                </span>
              )}
              {airport.speedLimitKt && (
                <span class="tnum">
                  {t("speedLimit")}: {airport.speedLimitKt} kt
                  {airport.speedLimitBelowFt
                    ? ` <${airport.speedLimitBelowFt} ft`
                    : ""}
                </span>
              )}
              {airport.bureau && <span>{airport.bureau}</span>}
              {airport.isInternational && (
                <span class="badge badge-info">{t("international")}</span>
              )}
              {airport.milOps && (
                <span class="badge badge-neutral">{airport.milOps}</span>
              )}
            </p>
            {/* The magnetic/true distinction is the single most expensive thing
                to get wrong downstream — it puts a parked aircraft skew to its
                own stand box — so the page says it rather than assuming the
                reader knows which one these columns are. */}
            <p class="mt-3 max-w-2xl text-xs text-faint">{t("magneticNote")}</p>
          </header>

          {/* 图排在表格前面：这一页的读者多半是在核对「这个机位是不是在它该在的
              地方」，而那件事看图一眼就知道，看一张 520 行的坐标表要一行行读。 */}
          <section class="mb-8">
            <AirportMap
              messages={mapMessages}
              airport={airport}
              client:only="vue"
            />
          </section>

          {/* **一张表，不是两张。** 几何（入口/终点坐标、航向）来自一份数据，物理
              （长宽道面强度）来自另一份，但读的人问的是同一件事：这条跑道是什么样。
              按代号拼在一起，缺哪一半就是破折号 —— 两张并排的表要读的人自己对代号。 */}
          <section class="mb-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-muted">
              {t("runways")} ({runwayRows.length})
            </h2>
            <p class="mb-3 text-xs text-faint">{t("runwayNote")}</p>
            <div class="scroll-edge-x overflow-x-auto">
              <table class="data-table w-full text-sm">
                <thead>
                  <tr>
                    <th>{t("rwy")}</th>
                    <th>{t("rwyLength")}</th>
                    <th>{t("rwyWidth")}</th>
                    <th>{t("rwySurface")}</th>
                    <th>{t("rwyStrength")}</th>
                    <th>hdg</th>
                    <th>{t("rwyThrElev")}</th>
                    <th>{t("rwyThreshold")}</th>
                  </tr>
                </thead>
                <tbody>
                  {runwayRows.map((r) => (
                    <tr>
                      <td data-label={t("rwy")} class="font-mono">
                        {r.ident}
                        {r.opposite ? (
                          <span class="text-faint"> / {r.opposite}</span>
                        ) : null}
                      </td>
                      <td data-label={t("rwyLength")} class="tnum">
                        {r.lengthM ? `${r.lengthM} m` : "—"}
                      </td>
                      <td data-label={t("rwyWidth")} class="tnum">
                        {r.widthM ? `${r.widthM} m` : "—"}
                      </td>
                      <td data-label={t("rwySurface")}>{r.surface ?? "—"}</td>
                      <td data-label={t("rwyStrength")} class="text-xs">
                        {r.strengthDesc ?? r.strength ?? "—"}
                      </td>
                      <td data-label="hdg" class="tnum">
                        {r.hdg ?? (r.trueBrg != null ? `${r.trueBrg}T` : "—")}
                      </td>
                      <td data-label={t("rwyThrElev")} class="tnum">
                        {r.thrElevM ? `${r.thrElevM} m` : "—"}
                      </td>
                      <td data-label={t("rwyThreshold")} class="tnum text-xs">
                        {r.lat != null
                          ? `${r.lat.toFixed(5)}, ${r.lon!.toFixed(5)}`
                          : "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-muted">
              {t("stands")} ({airport.stands.length})
            </h2>
            {/* Capped at 60 rendered rows. ZGGG has 520 stands and a wall of
                them helps nobody read this page; the count above is the honest
                number and the cap says so rather than silently truncating. */}
            <div class="flex flex-wrap gap-1.5">
              {airport.stands.slice(0, 60).map((s) => (
                <span
                  class="badge badge-neutral font-mono"
                  title={`${s.lat.toFixed(5)}, ${s.lon.toFixed(5)}${s.span ? ` · ${s.span} m` : ""}`}
                >
                  {s.name}
                </span>
              ))}
            </div>
            {airport.stands.length > 60 && (
              <p class="mt-2 text-xs text-faint">
                … {airport.stands.length - 60} more
              </p>
            )}
          </section>

          <section class="mb-8">
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-muted">
              {t("procedures")} ({airport.procedures.length})
            </h2>
            <Procedures
              messages={procMessages}
              procedures={airport.procedures}
              runways={runwayIdents}
              client:load
            />
          </section>
        </>
      )
    }
  </div>
</AppLayout>
