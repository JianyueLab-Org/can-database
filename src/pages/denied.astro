---
import AppLayout from "@/layouts/AppLayout.astro";
import Icon from "@jianyuelab-org/can-ui/components/Icon.vue";
import { siteUrl } from "@jianyuelab-org/can-ui/sites";
import { getLocale, useTranslations } from "@/lib/i18n";
import { webUrl } from "@/lib/config";
import { SITE_ORIGINS } from "@/lib/nav";

/**
 * 登录了，但 ADM 还没开权限。
 *
 * 这一页存在的理由写在 `src/middleware.ts` 里：把这个人弹回主站只会让他再点一次
 * 链接。他不是走错了地方 —— 他多半是被告知这里有东西要看的 —— 他需要的是一句
 * 「找谁开」。
 *
 * **不套侧栏。** 侧栏上的每一条他都点不进去，摆在那里只是四个 403。
 */
const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "denied");
const tNav = useTranslations(locale, "nav");
const user = Astro.locals.user;
---

<AppLayout title={t("title")} shell={false}>
  <main
    id="main-content"
    tabindex="-1"
    class="flex min-h-dvh items-center justify-center bg-surface-sunken px-4 py-16"
  >
    <div class="card mx-auto w-full max-w-lg p-6 sm:p-8">
      <span
        class="badge-warning flex size-11 items-center justify-center rounded-full"
      >
        <Icon name="key" class="size-5" />
      </span>
      <h1 class="text-title-2 mt-4 text-ink">{t("title")}</h1>
      <p class="mt-3 text-muted">{t("body")}</p>

      {
        /* 下一步是「找一位 ADM」，不是再点一次什么 —— 所以它单独成块，而不是埋在
          正文的第二段里。 */
      }
      <div class="mt-5 rounded-control bg-surface-sunken p-4">
        <p class="text-eyebrow text-faint">{t("nextStep")}</p>
        <p class="mt-1.5 text-sm text-ink">{t("how")}</p>
      </div>

      {
        user && (
          <p class="mt-5 text-sm text-faint">
            {t("signedInAs", { name: user.name, id: user.username })}
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={webUrl("/")} class="btn btn-primary">
          <Icon name="globeAlt" class="size-4" />
          {tNav("main")}
        </a>
        {
          /* 走 can-ui 的 siteUrl 而不是手写的 https://portal.ceruleanavi.net：
            本环境的 CAN_PORTAL_ORIGIN 经 SITE_ORIGINS 生效，生产上仍是线上门户。 */
        }
        <a
          href={siteUrl("portal", undefined, SITE_ORIGINS)}
          class="btn btn-secondary"
        >
          <Icon name="shieldCheck" class="size-4" />
          {tNav("portal")}
        </a>
      </div>
    </div>
  </main>
</AppLayout>
