---
import AppLayout from "@/layouts/AppLayout.astro";
import NoAccess from "@jianyuelab-org/can-ui/components/NoAccess.vue";
import { originsFromEnv } from "@jianyuelab-org/can-ui/sites";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { SITE_ORIGINS } from "@/lib/nav";

/**
 * 登录了，但 ADM 还没开资料库权限：403。
 *
 * 中间件把请求改写到这里（`next("/denied")`）：地址栏留在成员请求的地址，
 * `locals.noAccess` 写着原因。直接打开 `/denied` 的请求没有它，送回 `/`。
 *
 * 下一步是「找一位 ADM」，不是再点一次什么 —— 所以它单独成块，放在 `next-steps`。
 */
const reason = Astro.locals.noAccess;
const user = Astro.locals.user;
if (!reason || !user) return Astro.redirect("/");
Astro.response.status = 403;

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "denied");
const tFrame = useTranslations(locale, "frame");
const messages = getMessages(locale, "frame");
const shown =
  reason.kind === "permission"
    ? { kind: "permission" as const, name: t("permission") }
    : reason;
const origins = { ...originsFromEnv(import.meta.env), ...SITE_ORIGINS };
---

<AppLayout title={tFrame("noAccess.title")}>
  <NoAccess
    reason={shown}
    userName={user.name}
    userId={user.username}
    current="database"
    locale={locale}
    rating={user.rating}
    messages={messages}
    origins={origins}
  >
    <div slot="next-steps" class="flex flex-col gap-4">
      <p class="text-muted">{t("body")}</p>
      <div class="rounded-control bg-surface-sunken p-4">
        <p class="text-eyebrow text-faint">{t("nextStep")}</p>
        <p class="mt-1.5 text-sm text-ink">{t("how")}</p>
      </div>
    </div>
  </NoAccess>
</AppLayout>
